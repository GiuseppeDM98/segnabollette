{
  "name": "segnabollette",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:migrate:prod": "tsx scripts/migrate-prod.ts",
    "fixture:bills": "tsx scripts/make-bill-fixtures.ts",
    "documents:prune": "tsx --env-file-if-exists=.env.local scripts/prune-documents.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "nanoid": "6.0.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
