# Copy to .env.local and fill in. Never commit .env.local (.gitignore).
# Database — a local SQLite file in development; libsql://… plus a token in production.
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Registration: "true" opens it; missing or "false" keeps it closed.
SIGNUP_ENABLED="true"
# Extraction with Claude — a key of your own Console organization; extraction is disabled without it.
ANTHROPIC_API_KEY=""
# Private file store — the development store's token: vercel env pull .env.vercel-dev --environment=development,
# copy only this line here, then delete .env.vercel-dev (pulling into .env.local would overwrite the whole file).
BLOB_READ_WRITE_TOKEN=""
